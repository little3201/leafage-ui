    "axios": "^1.18.1",
    "pinia": "^4.0.2",
    "universal-cookie": "^8.1.2",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.7",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@intellectronica/ruler": "^0.3.44",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@mdi/font": "^7.4.47",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-vuetify": "^4.7.2",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.1",
