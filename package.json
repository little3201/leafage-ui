    "lint-staged": "^17.1.1",
    "msw": "^2.15.0",
    "npm-run-all2": "^9.0.2",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3",
    "unplugin-fonts": "^2.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
